{
  "name": "@hermit/desktop",
  "productName": "Hermit",
  "description": "Hermit desktop shell for a qualified bundled DeepSeek Harness generation",
  "author": "pgw10086",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib/**"
  ],
  "scripts": {
    "build": "corepack pnpm --filter @deepseek-ai/dsh-client-ui-layout build && tsc -p tsconfig.json && tsdown -c tsdown.quick-retrieval.config.ts && node scripts/copy-desktop-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.quick-retrieval.json --noEmit",
    "test": "corepack pnpm run build && node --test tests/*.test.mjs",
    "start": "corepack pnpm run prepare:electron && corepack pnpm run build && electron .",
    "prepare:electron": "node node_modules/electron/install.js",
    "prepare:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "prepare:dsh-runtime": "node scripts/prepare-dsh-runtime.mjs",
    "prepare:native": "node ../../native/macos-clipboard-bridge/scripts/build.mjs",
    "prepare:runtime": "corepack pnpm run prepare:node-runtime && corepack pnpm run prepare:dsh-runtime",
    "package:dir": "node scripts/package-desktop.mjs dir",
    "dist:mac:smoke": "node scripts/package-desktop.mjs mac-smoke",
    "dist:mac": "node scripts/package-desktop.mjs mac-release",
    "dist:win": "node scripts/assert-native-target.mjs --platform win32 --arch x64 && corepack pnpm run prepare:electron && corepack pnpm run prepare:native && corepack pnpm run prepare:runtime && corepack pnpm run build && electron-builder --win nsis",
    "verify:packaged-runtime": "node scripts/verify-packaged-runtime.mjs",
    "verify:mac:smoke": "node scripts/verify-mac-artifact.mjs smoke",
    "verify:mac:release": "node scripts/verify-mac-artifact.mjs release",
    "qualification:mac-login:status": "node scripts/qualify-mac-login.mjs status",
    "qualification:mac-login:prepare": "node scripts/qualify-mac-login.mjs prepare",
    "qualification:mac-login:verify": "node scripts/qualify-mac-login.mjs verify",
    "test:m1:desktop:packaged": "node tests/m1-desktop-packaged.e2e.mjs",
    "test:m1:replay:packaged": "node tests/m1-replay-packaged.e2e.mjs",
    "test:dsh:long-session": "node tests/dsh-long-session-replay.e2e.mjs",
    "test:organizer:ai:replay": "node tests/organizer-ai-replay-packaged.e2e.mjs",
    "test:organizer:product-surface": "node tests/organizer-product-surface.e2e.mjs",
    "test:file-workspace:product-surface": "node tests/file-workspace-product-surface.e2e.mjs",
    "test:smart-clipboard:product-surface": "node tests/smart-clipboard-product-surface.e2e.mjs",
    "test:smart-clipboard:packaged-ui": "node tests/smart-clipboard-packaged-ui.e2e.mjs",
    "test:conversation:quick:packaged": "node tests/conversation-quick-packaged.e2e.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@hermit/desktop-core": "file:../../vendor/hermit-desktop-core-0.1.0.tgz",
    "@hermit/file-workspace": "file:../../vendor/hermit-file-workspace-0.2.2.tgz",
    "@hermit/organizer": "file:../../vendor/hermit-organizer-0.2.2.tgz",
    "@hermit/smart-clipboard": "file:../../vendor/hermit-smart-clipboard-0.2.2.tgz",
    "pnpm": ">=11.0.0 <12"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@types/node": ">=24.0.0 <25",
    "@types/react": ">=18.3.0 <19",
    "@types/react-dom": ">=18.3.0 <19",
    "electron": ">=43.0.0 <44",
    "electron-builder": ">=26.0.0 <27",
    "lightningcss": ">=1.30.0 <2",
    "playwright-core": ">=1.55.0 <2",
    "react": ">=18.3.0 <19",
    "react-dom": ">=18.3.0 <19",
    "tsdown": ">=0.22.2 <0.23",
    "typescript": ">=6.0.0 <7"
  }
}
