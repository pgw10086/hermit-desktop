{
  "name": "@deepseek-ai/dsh-client-ui-layout",
  "description": "Hermit-patched DSH shell layout with public Product Surface, Desktop Surface, Shortcut Center and desktop capability contracts",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "hermitPatch": {
    "contractVersion": 6,
    "name": "product-navigation-shortcut-center-desktop-surface-and-primary-workspace",
    "upstreamRepository": "https://github.com/deepseek-ai/deepseek-harness.git",
    "upstreamTag": "dsh-v0.1.1-rc.2",
    "upstreamCommit": "b150a551b8d465e31e418e1b2eaf5e79bbb7d28e"
  },
  "files": [
    "LICENSE",
    "lib/index.js",
    "lib/index.js.map",
    "lib/invariant.js",
    "lib/invariant.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "corepack pnpm run clean && tsdown && tsc -p tsconfig.json",
    "test": "corepack pnpm run build && node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "react": ">=18.3.0 <19"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@types/node": ">=24.0.0 <25",
    "@types/react": ">=18.3.0 <19",
    "lightningcss": ">=1.32.0 <2",
    "react": ">=18.3.0 <19",
    "tsdown": ">=0.22.2 <0.23",
    "typescript": ">=6.0.0 <7"
  }
}
