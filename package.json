{
  "name": "@hermit/desktop-workspace",
  "version": "0.0.0-private",
  "packageManager": "pnpm@11.24.0",
  "repository": "https://github.com/pgw10086/hermit-desktop.git",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <27",
    "pnpm": ">=10.0.0 <13"
  },
  "scripts": {
    "doctor": "node scripts/check-environment.mjs",
    "verify:platform-lock": "node scripts/platform-lock.mjs verify --mode release",
    "prepare:platform:release": "node scripts/platform-lock.mjs prepare --mode release",
    "prepare:platform:dev": "node scripts/platform-lock.mjs prepare --mode dev --build-on-miss",
    "sync:platform-lock": "node scripts/platform-lock.mjs sync",
    "update:platform-lock": "node scripts/update-platform-lock.mjs",
    "verify:toolchain": "node scripts/check-environment.mjs --require qualification",
    "test:toolchain": "node --test scripts/toolchain-policy.test.mjs scripts/prepare-macos-release-assets.test.mjs scripts/prepare-windows-release-assets.test.mjs scripts/verify-release-input.test.mjs scripts/aggregate-release-assets.test.mjs scripts/publish-product-release.test.mjs apps/desktop-vnext/scripts/verify-windows-artifact.test.mjs apps/desktop-vnext/scripts/windows-release-environment.test.mjs",
    "test:platform-lock": "node --test scripts/platform-lock.test.mjs scripts/update-platform-lock.test.mjs",
    "test:package-product": "node --test scripts/package-product.test.mjs",
    "build:desktop": "corepack pnpm --filter @hermit/desktop build",
    "test:desktop": "corepack pnpm --filter @hermit/desktop test",
    "prepare:desktop-runtime": "node scripts/platform-lock.mjs prepare --mode release && corepack pnpm --filter @hermit/desktop prepare:runtime",
    "package:desktop:dir": "corepack pnpm --filter @hermit/desktop package:dir",
    "dist:desktop:mac:smoke": "corepack pnpm --filter @hermit/desktop dist:mac:smoke",
    "dist:desktop:mac": "corepack pnpm --filter @hermit/desktop dist:mac",
    "dist:desktop:win:smoke": "corepack pnpm --filter @hermit/desktop dist:win:smoke",
    "release:desktop:mac:assets": "node scripts/prepare-macos-release-assets.mjs",
    "verify:release-input": "node scripts/verify-release-input.mjs",
    "verify:desktop:win:smoke": "corepack pnpm --filter @hermit/desktop verify:win:smoke",
    "release:desktop:win:assets": "node scripts/prepare-windows-release-assets.mjs",
    "dist:desktop:win": "corepack pnpm --filter @hermit/desktop dist:win",
    "verify:desktop:packaged-runtime": "corepack pnpm --filter @hermit/desktop verify:packaged-runtime",
    "qualification:desktop:mac-login:status": "corepack pnpm --filter @hermit/desktop qualification:mac-login:status",
    "qualification:desktop:mac-login:prepare": "corepack pnpm --filter @hermit/desktop qualification:mac-login:prepare",
    "qualification:desktop:mac-login:verify": "corepack pnpm --filter @hermit/desktop qualification:mac-login:verify",
    "test:m1:desktop:packaged": "corepack pnpm --filter @hermit/desktop test:m1:desktop:packaged",
    "test:m1:replay:packaged": "corepack pnpm --filter @hermit/desktop test:m1:replay:packaged",
    "test:dsh:long-session": "corepack pnpm --filter @hermit/desktop test:dsh:long-session",
    "test:file-workspace:product-surface": "corepack pnpm --filter @hermit/desktop test:file-workspace:product-surface",
    "test:organizer:product-surface": "corepack pnpm --filter @hermit/desktop test:organizer:product-surface",
    "test:smart-clipboard:product-surface": "corepack pnpm --filter @hermit/desktop test:smart-clipboard:product-surface",
    "test:smart-clipboard:packaged-ui": "corepack pnpm --filter @hermit/desktop test:smart-clipboard:packaged-ui",
    "test:smart-clipboard:focus-restore": "corepack pnpm --filter @hermit/desktop test:smart-clipboard:focus-restore",
    "test:smart-clipboard:native": "corepack pnpm --filter @hermit/macos-clipboard-bridge test",
    "verify:agent-contracts": "node scripts/verify-agent-contracts.mjs",
    "verify:document-governance": "node scripts/check-document-governance.mjs",
    "verify:plugin-manifests": "node scripts/verify-plugin-manifests.mjs",
    "verify:dsh-upstream": "node scripts/verify-dsh-upstream-snapshot.mjs",
    "verify:peers": "corepack pnpm install --lockfile-only --frozen-lockfile --ignore-scripts --strict-peer-dependencies",
    "qualification:public-contracts": "corepack pnpm run qualification:typecheck && node scripts/qualification/verify-public-contracts.mjs",
    "qualification:client-module-host": "node scripts/qualification/verify-client-module-host.mjs",
    "qualification:product-surface": "node scripts/qualification/verify-product-surface.mjs",
    "qualification:install": "node scripts/qualification/verify-clean-install.mjs",
    "qualification:typecheck": "node node_modules/typescript/bin/tsc -p scripts/qualification/tsconfig.json",
    "test:qualification": "node --test scripts/qualification/qualification.test.mjs",
    "test": "corepack pnpm run verify:toolchain && corepack pnpm run test:toolchain && corepack pnpm run test:platform-lock && corepack pnpm run test:package-product && node scripts/verify-agent-contracts.mjs && node scripts/check-document-governance.mjs && node scripts/verify-plugin-manifests.mjs && node scripts/verify-dsh-upstream-snapshot.mjs && corepack pnpm run verify:peers && corepack pnpm run qualification:public-contracts && node --test scripts/qualification/qualification.test.mjs && corepack pnpm --filter @hermit/desktop test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web-app": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web-frontend": "0.1.1-rc.2",
    "react": ">=18.3.0 <19",
    "react-dom": ">=18.3.0 <19",
    "typescript": ">=6.0.0 <7",
    "yaml": ">=2.9.0 <3"
  }
}
