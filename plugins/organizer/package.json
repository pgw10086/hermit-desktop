{
  "name": "@hermit/organizer",
  "version": "0.1.0",
  "description": "Hermit Personal Organizer Product Plugin",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "README.md",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "corepack pnpm run clean && tsdown -c tsdown.config.ts && tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test": "corepack pnpm run build && node --test tests/*.test.mjs"
  },
  "license": "Apache-2.0",
  "hermit": {
    "type": "product-plugin"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "react": ">=18.3.0 <19"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": ">=24.0.0 <25",
    "@types/react": ">=18.3.0 <19",
    "lightningcss": ">=1.30.0 <2",
    "react": ">=18.3.0 <19",
    "tsdown": ">=0.22.2 <0.23",
    "typescript": ">=6.0.0 <7"
  },
  "dependencies": {
    "zod": ">=4.4.3 <5"
  }
}
